; Engine configuration file.
; Tunable gameplay/visual values live in res://config/*.cfg, not here.

config_version=5

[application]

config/name="Oh S#IT: The Life Skills Game - Garage"
config/description="3D flat tire procedure in a night garage."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Config="*res://src/autoload/config.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
